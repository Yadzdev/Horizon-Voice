# Copy to .env on the VPS. Replace every CHANGE_ME value with a unique secret.
POSTGRES_DB=horizon_voice
POSTGRES_USER=horizon_voice
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_POSTGRES_PASSWORD
REDIS_PASSWORD=CHANGE_ME_LONG_RANDOM_REDIS_PASSWORD
JWT_SECRET=CHANGE_ME_AT_LEAST_64_RANDOM_CHARACTERS

# Pin a specific tested release before production upgrades.
LIVEKIT_IMAGE=livekit/livekit-server:v1.13.11
# This is an API key ID (not a secret). It must match infra/livekit/livekit.yaml webhook.api_key.
LIVEKIT_API_KEY=horizon_voice
LIVEKIT_API_SECRET=CHANGE_ME_LIVEKIT_SECRET

# Optional API observability. Leave empty/false to disable.
SENTRY_DSN=
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
